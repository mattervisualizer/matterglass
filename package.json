{
  "name": "matterglass",
  "version": "0.0.1",
  "description": "Liquid glass for React: real refraction of the background through SVG displacement maps",
  "keywords": [
    "react",
    "glass",
    "liquid-glass",
    "glassmorphism",
    "refraction",
    "backdrop-filter",
    "ui"
  ],
  "license": "MIT",
  "author": "mattervisualizer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mattervisualizer/matterglass.git"
  },
  "homepage": "https://github.com/mattervisualizer/matterglass#readme",
  "bugs": {
    "url": "https://github.com/mattervisualizer/matterglass/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vite-plugin-dts": "^4.0.0"
  }
}
